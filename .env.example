# Dossier de données persistant (photos, miniatures, base SQLite).
# Doit vivre HORS du dossier de build. Sur le VPS : /var/lib/defi-photo
DATA_DIR="./data"

# Optionnel : force l'URL de la base. Par défaut, <DATA_DIR>/app.db.
# DATABASE_URL="file:/var/lib/defi-photo/app.db"

# Mot de passe de la console /admin (phase 3). À changer avant la mise en ligne.
ADMIN_PASSWORD="change-moi"

# Secret de signature du cookie de session admin (phase 3).
# Générer avec : openssl rand -base64 32
ADMIN_SESSION_SECRET="change-moi-aussi"
